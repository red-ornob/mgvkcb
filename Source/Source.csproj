<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>mgvkcbgame</AssemblyName>
    <AssemblyTitle>mgvkcbgame</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2026.11.2.1" />
    <PackageReference Include="Gum.Shapes.MonoGame" Version="2026.11.2.1" />
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.6.1" />
  </ItemGroup>
  <Import Project="..\Content\BuildContent.targets" />
</Project>
